From: José Augusto de Lima Prestes <doutorprestes@gmail.com>
Date: Tue, 19 May 2026
Subject: [PATCH 1/2] Fix user config ignored when project config exists

Vibe CLI was ignoring ~/.vibe/config.toml when a project-level
.vibe/config.toml existed. User-defined [[models]] and active_model
were silently discarded.

  - TomlFileSettingsSource._load_toml(): merge user + project configs
    with user taking precedence when both "user" and "project" sources
    are enabled
  - _deep_merge_preserving_lists(): intelligent merge for models and
    providers lists by identifier (alias / name)

This patch is a derivative work of Mistral Vibe, Copyright Mistral AI.
Original: https://github.com/mistralai/mistral-vibe (Apache 2.0)
Signed-off-by: José Augusto de Lima Prestes <doutorprestes@gmail.com>

diff --git a/vibe/core/config/_settings.py b/vibe/core/config/_settings.py
index 7f2fddc..b7b7264 100644
--- a/vibe/core/config/_settings.py
+++ b/vibe/core/config/_settings.py
@@ -82,18 +82,95 @@ class TomlFileSettingsSource(PydanticBaseSettingsSource):
         self.toml_data = self._load_toml()
 
     def _load_toml(self) -> dict[str, Any]:
-        file = get_harness_files_manager().config_file
-        if file is None:
-            return {}
-        try:
-            with file.open("rb") as f:
-                return tomllib.load(f)
-        except FileNotFoundError:
-            return {}
-        except tomllib.TOMLDecodeError as e:
-            raise RuntimeError(f"Invalid TOML in {file}: {e}") from e
-        except OSError as e:
-            raise RuntimeError(f"Cannot read {file}: {e}") from e
+        mgr = get_harness_files_manager()
+
+        if "user" in mgr.sources and "project" in mgr.sources:
+            merged_data = {}
+            project_file = mgr.config_file
+            if (
+                project_file
+                and project_file.is_file()
+                and mgr._trusted_workdir is not None
+            ):
+                try:
+                    with project_file.open("rb") as f:
+                        merged_data = tomllib.load(f)
+                except (FileNotFoundError, tomllib.TOMLDecodeError, OSError):
+                    pass
+
+            user_file = mgr.user_config_file
+            if user_file and user_file.is_file():
+                try:
+                    with user_file.open("rb") as f:
+                        user_data = tomllib.load(f)
+                    merged_data = self._deep_merge_preserving_lists(
+                        merged_data, user_data
+                    )
+                except (FileNotFoundError, tomllib.TOMLDecodeError, OSError):
+                    pass
+
+            return merged_data
+        else:
+            file = mgr.config_file
+            if file is None:
+                return {}
+            try:
+                with file.open("rb") as f:
+                    return tomllib.load(f)
+            except FileNotFoundError:
+                return {}
+            except tomllib.TOMLDecodeError as e:
+                raise RuntimeError(f"Invalid TOML in {file}: {e}") from e
+            except OSError as e:
+                raise RuntimeError(f"Cannot read {file}: {e}") from e
+
+    def _deep_merge_preserving_lists(
+        self, base: dict[str, Any], overlay: dict[str, Any]
+    ) -> dict[str, Any]:
+        result = dict(base)
+
+        for key, value in overlay.items():
+            if (
+                key in result
+                and isinstance(result[key], list)
+                and isinstance(value, list)
+            ):
+                if key == "models":
+                    base_models_by_alias = {
+                        model.get("alias"): model
+                        for model in result[key]
+                        if isinstance(model, dict) and model.get("alias")
+                    }
+
+                    for overlay_model in value:
+                        if isinstance(overlay_model, dict) and overlay_model.get(
+                            "alias"
+                        ):
+                            alias = overlay_model["alias"]
+                            base_models_by_alias[alias] = overlay_model
+
+                    result[key] = list(base_models_by_alias.values())
+                elif key == "providers":
+                    base_providers_by_name = {
+                        provider.get("name"): provider
+                        for provider in result[key]
+                        if isinstance(provider, dict) and provider.get("name")
+                    }
+
+                    for overlay_provider in value:
+                        if isinstance(overlay_provider, dict) and overlay_provider.get(
+                            "name"
+                        ):
+                            name = overlay_provider["name"]
+                            base_providers_by_name[name] = overlay_provider
+
+                    result[key] = list(base_providers_by_name.values())
+                else:
+                    result[key] = value
+            else:
+                result[key] = value
+
+        return result
 
     def get_field_value(
         self, field: FieldInfo, field_name: str
